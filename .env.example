# Banco de dados (consumido pelo docker-compose)
POSTGRES_USER=compostagem
POSTGRES_PASSWORD=compostagem
POSTGRES_DB=compostagem
POSTGRES_PORT=5432

# API
API_PORT=8000
AMBIENTE=desenvolvimento
DEBUG=true

# Autenticação JWT
# Em produção, gere um segredo longo e aleatório (ex.: openssl rand -hex 32).
JWT_SEGREDO=troque-este-segredo-em-producao-com-uma-chave-longa-e-aleatoria
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=480

# Usado apenas ao rodar a API fora do Docker (localhost no lugar de db)
# DATABASE_URL=postgresql+asyncpg://compostagem:compostagem@localhost:5432/compostagem
