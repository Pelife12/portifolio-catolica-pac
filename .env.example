# Banco de dados (consumido pelo docker-compose)
POSTGRES_USER=compostagem
POSTGRES_PASSWORD=compostagem
POSTGRES_DB=compostagem
POSTGRES_PORT=5432

# API
API_PORT=8000
AMBIENTE=desenvolvimento
DEBUG=true

